.hud { flex-grow: 1; color: rgb(226, 230, 226); }
.scorebar { position: absolute; top: 16px; left: 50%; translate: -50% 0; width: 520px; height: 54px; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 18px; background-color: rgba(8, 14, 18, 0.9); border-bottom-width: 2px; border-bottom-color: rgb(72, 137, 190); }
.score { font-size: 13px; letter-spacing: 1px; -unity-font-style: bold; }
.timer { font-size: 20px; color: white; -unity-font-style: bold; }
.map { font-size: 10px; letter-spacing: 2px; color: rgb(139, 157, 164); }
.reticle { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 42px; height: 42px; }
.reticle-line { position: absolute; background-color: rgba(235, 242, 236, 0.92); }
.reticle-top { left: 20px; top: 4px; width: 2px; height: 10px; }
.reticle-bottom { left: 20px; bottom: 4px; width: 2px; height: 10px; }
.reticle-left { left: 4px; top: 20px; width: 10px; height: 2px; }
.reticle-right { right: 4px; top: 20px; width: 10px; height: 2px; }
.hit-marker { display: none; position: absolute; left: 10px; top: 2px; width: 22px; height: 34px; -unity-text-align: middle-center; font-size: 27px; color: rgb(255, 177, 90); -unity-font-style: bold; }
.health-panel { position: absolute; left: 24px; bottom: 28px; width: 260px; padding: 14px 16px; background-color: rgba(8, 14, 18, 0.91); border-left-width: 3px; border-left-color: rgb(63, 139, 210); }
.micro { font-size: 9px; letter-spacing: 2px; color: rgb(139, 157, 164); }
.health-number { font-size: 28px; color: white; -unity-font-style: bold; }
.health-track { height: 5px; margin-top: 4px; background-color: rgb(44, 52, 55); }
.health-fill { width: 100%; height: 5px; background-color: rgb(72, 156, 203); }
.weapon-panel { position: absolute; right: 24px; bottom: 28px; width: 260px; padding: 13px 16px; align-items: flex-end; background-color: rgba(8, 14, 18, 0.91); border-right-width: 3px; border-right-color: rgb(63, 139, 210); }
.weapon-name { margin-top: 2px; font-size: 13px; letter-spacing: 2px; color: rgb(209, 221, 224); -unity-font-style: bold; }
.ammo-row { height: 50px; flex-direction: row; align-items: flex-end; }
.ammo-number { font-size: 45px; color: white; -unity-font-style: bold; }
.reserve-number { margin-left: 8px; margin-bottom: 7px; font-size: 16px; color: rgb(139, 157, 164); }
.reload-label { margin-top: 1px; font-size: 9px; letter-spacing: 2px; color: rgb(101, 175, 224); }
.reload-alert { color: rgb(255, 151, 79); -unity-font-style: bold; }
.quickbar { position: absolute; bottom: 48px; left: 50%; translate: -50% 0; height: 42px; flex-direction: row; }
.quickslot { min-width: 92px; margin-left: 3px; margin-right: 3px; padding: 6px 9px; flex-direction: row; align-items: center; background-color: rgba(8, 14, 18, 0.68); border-bottom-width: 2px; border-bottom-color: rgba(103, 120, 126, 0.5); opacity: 0.48; }
.quickslot-active { border-bottom-color: rgb(70, 163, 220); opacity: 1; }
.slot-key { width: 18px; font-size: 9px; color: rgb(111, 185, 228); -unity-font-style: bold; }
.slot-name { font-size: 9px; letter-spacing: 1px; color: rgb(207, 216, 216); }
.controls { position: absolute; bottom: 14px; left: 50%; translate: -50% 0; font-size: 8px; letter-spacing: 1px; color: rgba(188, 199, 201, 0.7); }
.result-panel { display: none; position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 500px; height: 180px; align-items: center; justify-content: center; background-color: rgba(6, 12, 16, 0.96); border-top-width: 3px; border-top-color: rgb(87, 195, 143); }
.result-title { font-size: 42px; letter-spacing: 5px; color: white; -unity-font-style: bold; }
.result-copy { margin-top: 16px; font-size: 11px; letter-spacing: 1px; color: rgb(139, 157, 164); }
