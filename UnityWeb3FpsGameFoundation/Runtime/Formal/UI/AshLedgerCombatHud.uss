.hud { flex-grow: 1; color: rgb(226, 230, 226); }
.scorebar { position: absolute; top: 16px; left: 50%; translate: -50% 0; width: 520px; height: 54px; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 18px; background-color: rgba(8, 14, 18, 0.9); border-bottom-width: 2px; border-bottom-color: rgb(72, 137, 190); }
.score { font-size: 13px; letter-spacing: 1px; -unity-font-style: bold; }
.timer { font-size: 20px; color: white; -unity-font-style: bold; }
.map { font-size: 10px; letter-spacing: 2px; color: rgb(139, 157, 164); }
.crosshair { position: absolute; left: 50%; top: 50%; translate: -50% -50%; font-size: 25px; color: rgba(235, 242, 236, 0.9); }
.health-panel { position: absolute; left: 24px; bottom: 28px; width: 260px; padding: 14px 16px; background-color: rgba(8, 14, 18, 0.91); border-left-width: 3px; border-left-color: rgb(63, 139, 210); }
.micro { font-size: 9px; letter-spacing: 2px; color: rgb(139, 157, 164); }
.health-number { font-size: 28px; color: white; -unity-font-style: bold; }
.health-track { height: 5px; margin-top: 4px; background-color: rgb(44, 52, 55); }
.health-fill { width: 100%; height: 5px; background-color: rgb(72, 156, 203); }
.controls { position: absolute; bottom: 18px; left: 50%; translate: -50% 0; font-size: 9px; letter-spacing: 1px; color: rgba(188, 199, 201, 0.75); }
.result-panel { display: none; position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 500px; height: 180px; align-items: center; justify-content: center; background-color: rgba(6, 12, 16, 0.96); border-top-width: 3px; border-top-color: rgb(87, 195, 143); }
.result-title { font-size: 42px; letter-spacing: 5px; color: white; -unity-font-style: bold; }
.result-copy { margin-top: 16px; font-size: 11px; letter-spacing: 1px; color: rgb(139, 157, 164); }
